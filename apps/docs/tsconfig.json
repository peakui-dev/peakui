{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@/.source": ["./.source/server.ts"],
      "@/.source/*": ["./.source/*"],
      "@/*": ["./src/*"]
    },
    "plugins": [{"name": "next"}],
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/testing/globals.d.ts"
  ],
  "exclude": ["node_modules"]
}
