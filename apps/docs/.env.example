# The public origin of the docs site, for example https://docs.example.com.
# Required by `next build` and again when the production server starts (`next start`): both fail
# when it is missing or not a valid absolute URL. Every absolute URL in /llms.txt,
# /llms-components.txt, /llms-patterns.txt and /api/components is written from it, and its value is
# inlined at build time, so changing it needs a rebuild. `next dev` falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
