# The public origin of the docs site, for example https://docs.example.com.
# Required by `next build`: every absolute URL in /llms.txt, /llms-components.txt,
# /llms-patterns.txt and /api/components is written from it at build time, and the build fails
# when it is missing or not a valid absolute URL. `next dev` falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
