# Документы. Prettier выравнивает markdown-таблицы пробелами, разгоняя строки далеко за 100
# символов, и переписывает *курсив* в _курсив_ — то есть отменяет стиль, в котором здесь написан
# каждый документ. Код, конфиги и CSS он форматирует как обычно.
*.md
*.mdx

# Сгенерированные файлы тем: их формат — вывод генератора (src/generator/index.ts), и check:tokens
# сверяет variables.css байт в байт — переформатировав его, Prettier ломает гейт токенов.
#
# Исключение по путям, а не по каталогу: gitignore-семантика не умеет вернуть файл, у которого
# исключён родительский каталог, поэтому "packages/styles/themes/" плюс "!.../shared/" выключал и
# рукописный themes/shared/theme.css — 7 КБ токенов, через которые разрешается каждый var(--color-*).
packages/styles/themes/*/variables.css
packages/styles/themes/*/index.css
packages/styles/themes/*/components/index.css
evals/results/
