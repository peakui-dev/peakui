{
  "name": "peakui-monorepo",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build:storybook": "pnpm --filter @peakui/storybook build",
    "check:tokens": "pnpm --filter @peakui/styles check:tokens",
    "codegraph": "codegraph",
    "codegraph:status": "codegraph status",
    "codegraph:sync": "codegraph sync",
    "dev:storybook": "pnpm --filter @peakui/storybook dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "lint:package": "pnpm -r lint:package",
    "test": "pnpm -r test",
    "test:ai": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "pnpm --filter @peakui/storybook test:e2e",
    "test:e2e:ci": "pnpm --filter @peakui/storybook test:e2e:ci",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.1",
    "@eslint/js": "9.39.2",
    "@peakui/standard": "workspace:*",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "agent-browser": "0.38.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "16.5.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
